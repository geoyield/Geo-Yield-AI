# ==============================================================================
# DOCKERFILE CUSTOM PARA BASE DE DATOS (PostgreSQL + PostGIS + pgvector)
# ==============================================================================
# Para la arquitectura de este proyecto necesitamos un motor híbrido que maneje 
# tanto geometría (PostGIS) como vectores de Inteligencia Artificial (pgvector).
# 
# Decisión de Diseño:
# En lugar de heredar de la imagen prefabricada de PostGIS (que no incluye pgvector) 
# y arriesgarnos a problemas de compatibilidad de repositorios, partimos de la 
# imagen base oficial de PostgreSQL 18. Esta imagen garantiza el acceso nativo 
# al repositorio oficial PGDG (apt.postgresql.org), permitiéndonos instalar 
# de forma limpia y controlada ambas extensiones en su versión compatible.
FROM postgres:18

# Instalación de dependencias y optimización de la capa (Layer).
# Se aplican las mejores prácticas de creación de contenedores (Dockerfile Best Practices):
# 1. Se usa --no-install-recommends para evitar descargar librerías innecesarias.
# 2. Se encadenan los comandos con '&&' para generar una única capa (layer) en Docker.
# 3. Se elimina la caché de paquetes de apt (rm -rf...) al finalizar para 
#    reducir drásticamente el peso del contenedor resultante.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        postgresql-18-postgis-3 \
        postgresql-18-pgvector \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
