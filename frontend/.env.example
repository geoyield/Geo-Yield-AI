# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# File: frontend/.env.example
#
# Base URL for the Backend API.
# Security Note: Vite will only expose variables to the browser if they
# are explicitly prefixed with "VITE_".
#
# In local development (running Uvicorn standalone), it points to localhost:8000.
# If left undefined, the frontend defaults to this value.
# Note: docker-compose publishes the API on host port 8080, not 8000 -- change
# this value accordingly when running the backend via docker-compose.
VITE_API_BASE_URL=http://localhost:8000

# --- Logging (frontend/src/services/logger.js) ---
# Behaviour follows the build mode, so normally nothing here needs changing:
#
#   npm run dev     ->  readable logs in the browser console, DEBUG level,
#                       nothing sent over the network
#   npm run build   ->  JSON in the console and events shipped to
#                       POST /api/logs, from where they reach CloudWatch
#
# The variables below only exist to override that.

# Minimum level recorded: DEBUG | INFO | WARNING | ERROR.
# VITE_LOG_LEVEL=

# "true" ships logs even in development (useful to test the pipeline end to
# end locally); "false" disables shipping in production too.
# VITE_LOG_REMOTE=

# Shows up in the "version" field of every log. In CI, inject the tag or
# commit SHA here to attribute an error spike to a specific deploy.
VITE_APP_VERSION=0.1.0

# We are using this environment variable to know if we are in production or not.
ENV=development