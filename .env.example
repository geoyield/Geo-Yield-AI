# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (Single Source of Truth)
# ==============================================================================
# Instructions: Copy this file as ".env" in the project root.
# SECURITY NOTE: The real ".env" file must be git-ignored so credentials are
# never exposed. This template defines the required structure.

# --- 1. Database (PostgreSQL + PostGIS + pgvector) ---
POSTGRES_DB=geoyield
POSTGRES_USER=geoyield_user
POSTGRES_PASSWORD=changeme

# SQLAlchemy connection string.
# Network architecture (Docker vs local):
# - In Docker: the host must be "postgis" (the service name in docker-compose).
# - Locally (development without Docker): the host must be changed to "localhost".
# Injection of this variable is centralized in `backend/db/connection.py`.
DATABASE_URL=postgresql+psycopg2://geoyield_user:changeme@postgis:5432/geoyield

# Local development convenience only (never used in Docker or production):
# "postgis" only resolves inside Docker's internal network, so a script run
# directly on your machine (outside any container) cannot reach the DB
# unless the host in DATABASE_URL is overridden at runtime.
#
#   DB_HOST_OVERRIDE=localhost python some_script.py
#
# If the container also publishes Postgres on a non-default host port (e.g.
# because 5432 is already taken locally), override the port too:
#
#   DB_HOST_OVERRIDE=localhost DB_PORT_OVERRIDE=5433 python some_script.py
#
# DB_HOST_OVERRIDE=
# DB_PORT_OVERRIDE=

# --- Logging / observability ---
# Behaviour is derived from ENV (see "Execution Environment" below), so
# normally you do not need to touch anything here:
#
#   ENV=development  ->  readable coloured text on the console, DEBUG level,
#                        nothing shipped to AWS
#   ENV=production   ->  one JSON line per event, INFO level, and CloudWatch
#                        shipping when LOG_CLOUDWATCH_GROUP is set
#
# The variables below only exist to override that.

# Accepts either the number (10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR) or the
# name ("INFO"). Unset = DEBUG locally, INFO in production.
# LOG_LEVEL=

# "text" or "json". Unset = text locally, json in production.
# LOG_FORMAT=

SERVICE_NAME=geoyield-api
SERVICE_VERSION=0.1.0

# Optional extra log file. Leave EMPTY in a container: a file inside a
# container is not picked up by any collector.
# LOG_FILE=

# Comma-separated CORS origins. Add the real frontend domain when deploying,
# or the browser can neither call the API nor ship its logs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# --- CloudWatch shipping ---
# Setting a log group is the opt-in, and it only takes effect when
# ENV=production. Set it on hosts that do NOT collect stdout (e.g. Render).
# On ECS/Fargate/App Runner leave it EMPTY: the host driver already ships
# stdout, and pushing as well means paying twice for the same ingestion.
# Requires: pip install boto3 watchtower
LOG_CLOUDWATCH_GROUP=

# Forces shipping on or off regardless of ENV. Normally left unset.
# LOG_CLOUDWATCH_ENABLED=

# Empty = container hostname, which distinguishes replicas.
LOG_CLOUDWATCH_STREAM=
# Without a retention policy a new log group keeps events forever and bills
# storage indefinitely.
LOG_CLOUDWATCH_RETENTION_DAYS=30
LOG_CLOUDWATCH_SEND_INTERVAL=10
AWS_REGION=eu-west-1
# Credentials: ONLY when pushing from a host without an IAM role (Render).
# On ECS/Fargate/App Runner leave them unset and use the task role.
# Minimum permissions: logs:CreateLogGroup, logs:CreateLogStream,
# logs:PutLogEvents, logs:PutRetentionPolicy on arn:aws:logs:*:*:log-group:/geoyield/*
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- 3. Execution Environment ---
# "development" enables Uvicorn's hot reload.
# In production, any other value (e.g. "production") disables it.
ENV=development

# --- 4. Phase 2: RAG Engine and Generation (Artificial Intelligence) ---
# Architecture note (MVP): vector embeddings run locally (zero cost, via
# sentence-transformers). For generation, Gemini was chosen as the MVP
# provider.
GEMINI_API_KEY=

# Default model (configurable). If omitted, the code uses gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Fallback / Future decision:
# If funding is secured for the production environment, the architecture is
# ready (see gemini_adapter.py) to switch back to Anthropic (Claude) without
# needing to refactor the business logic.
# ANTHROPIC_API_KEY=