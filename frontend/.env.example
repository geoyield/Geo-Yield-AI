# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# File: frontend/.env.example
#
# Base URL for the Backend API. 
# Security Note: Vite will only expose variables to the browser if they 
# are explicitly prefixed with "VITE_". 
#
# In local development (running Uvicorn standalone), it points to localhost:8000.
# If left undefined, the frontend defaults to this value.
VITE_API_BASE_URL=http://localhost:8000
