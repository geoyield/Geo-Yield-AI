# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO (Single Source of Truth)
# ==============================================================================
# Instrucciones: Copia este archivo como ".env" en la raíz del proyecto.
# NOTA DE SEGURIDAD: El archivo ".env" real debe estar ignorado en Git para 
# no exponer credenciales. Esta plantilla define la estructura requerida

# --- 1. Base de Datos (PostgreSQL + PostGIS + pgvector) ---
POSTGRES_DB=geoyield
POSTGRES_USER=geoyield_user
POSTGRES_PASSWORD=changeme

# Cadena de conexión para SQLAlchemy. 
# Arquitectura de Red (Docker vs Local):
# - En Docker: El host debe ser "postgis" (nombre del servicio en docker-compose).
# - En Local (desarrollo sin Docker): El host debe cambiarse a "localhost".
# La inyección de esta variable la centraliza `backend/db/connection.py`.
DATABASE_URL=postgresql+psycopg2://geoyield_user:changeme@postgis:5432/geoyield

# --- 2. Observabilidad (Logging) ---
# Niveles de registro estándar: 10=DEBUG, 20=INFO, 30=WARNING, 40=ERROR
# Centralizado en main.py. En producción debería subirse a 30 (WARNING).
LOG_LEVEL=20

# --- 3. Entorno de Ejecución ---
# "development" habilita la recarga en caliente (Hot Reload) de Uvicorn.
# En producción, cualquier otro valor (ej: "production") lo desactiva
ENV=development

# --- 4. Fase 2: Motor RAG y Generación (Inteligencia Artificial) ---
# Nota de Arquitectura (MVP): Los embeddings vectoriales se ejecutan en local 
# (coste cero vía sentence-transformers). Para la generación, se ha optado por 
# Gemini como proveedor del Producto Mínimo Viable (MVP).
GEMINI_API_KEY=

# Modelo por defecto (configurable). Si se omite, el código usa gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# Fallback / Decisión Futura:
# Si se consiguen fondos para el entorno de producción, la arquitectura está 
# preparada (ver gemini_adapter.py) para volver a Anthropic (Claude) sin 
# necesidad de refactorizar la lógica de negocio.
# ANTHROPIC_API_KEY=
