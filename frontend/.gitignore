# ==============================================================================
# REPOSITORY HYGIENE: GIT IGNORE RULES (FRONTEND)
# ==============================================================================
# File: frontend/.gitignore
# Specifies intentionally untracked files that Git should ignore.

# ------------------------------------------------------------------------------
# LOGS & DEBUGGING
# ------------------------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# DEPENDENCIES & BUILD ARTIFACTS
# ------------------------------------------------------------------------------
# Do not track the 500MB+ node_modules folder. Reproducibility is handled 
# via package.json and package-lock.json.
node_modules

# Do not track compiled production output. Git is for source code, 
# not for build artifacts. These should be generated by the CI/CD pipeline.
dist
dist-ssr

# Ignore local environment files containing secrets (e.g., .env.local)
*.local

# ------------------------------------------------------------------------------
# OS & EDITOR SPECIFIC FILES
# ------------------------------------------------------------------------------
# Ignore personal VS Code settings (themes, local debug configs) to avoid 
# conflicts between team members.
.vscode/*

# Smart Exception: Force Git to TRACK the extensions.json file.
# This ensures any developer cloning the repo is prompted to install the 
# team's required extensions (like Vue Volar or Tailwind IntelliSense).
!.vscode/extensions.json

.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?