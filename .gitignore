# FRONT
frontend/node_modules/

# --- ML & data artifacts ---
mlruns/
artifacts/
models/
*.log
*.h5
*.pkl
*.joblib
*.ckpt

# --- Data files ---
data/
*.csv
*.tsv
*.json
# ...but *.json above is meant for raw data only. Without these exceptions it
# also swallows the frontend manifests, which is why frontend/package.json was
# never committed and the app could not be installed from a clean clone.
!frontend/package.json
!frontend/package-lock.json
!**/.vscode/*.json
*.xlsx
*.parquet
*.zip
*.gz

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
build/
dist/

# --- Virtual environments ---
#.env
.venv/
env/
venv/
ENV/
*.env

# --- CI/CD secrets ---
*.pem
*.key
.envrc
.env.*
!.env.example

# --- Misc ---
README_devops_g5.md
tmp/

# Archivos de prueba y mapas locales
generar_mapa_dependencias.py
mapa_dependencias_template.html
mapa_dependencias.html
prueba_agente.py
prueba_rag.py

# Local-only runbook; the file itself says it is not meant to be committed.
RUNBOOK.local.md
